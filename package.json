{
  "name": "the-seed-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "engine": "engine/build.sh",
    "assets": "capacitor-assets generate --iconBackgroundColor '#0F0128' --iconBackgroundColorDark '#0F0128' --splashBackgroundColor '#0F0128' --splashBackgroundColorDark '#0F0128'",
    "sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/clipboard": "^7.0.4",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "framer-motion": "^14.11.1",
    "howler": "^2.2.4",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.6.10",
    "@types/howler": "^2.2.13",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
